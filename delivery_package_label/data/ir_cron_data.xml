<odoo noupdate="1">
    <record id="ir_cron_package_label" model="ir.cron">
        <field name="name">Delivery: create carrier labels per package</field>
        <field name="model_id" ref="stock.model_stock_picking" />
        <field name="state">code</field>
        <field name="code">model._cron_generate_package_labels()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True" />
    </record>
</odoo>
