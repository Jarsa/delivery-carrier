<odoo>
    <record id="view_delivery_carrier_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.package.label</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <field name="integration_level" position="after">
                <field name="package_label_support" invisible="1" />
                <field
                    name="package_label_generation"
                    invisible="integration_level != 'rate_and_ship' or not package_label_support"
                />
            </field>
        </field>
    </record>
</odoo>
